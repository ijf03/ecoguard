{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "EcoGuard protected serverless API, versioned private media, image/video inference, thumbnails, and bounded recovery.",
  "Parameters": {
    "ArtifactBucket": {
      "Type": "String"
    },
    "ArtifactKey": {
      "Type": "String"
    },
    "FrontendOrigin": {
      "Type": "String",
      "Default": "http://127.0.0.1:5173"
    },
    "ThumbnailArtifactKey": {
      "Type": "String"
    },
    "InferenceArtifactKey": {
      "Type": "String"
    },
    "ModelKey": {
      "Type": "String"
    },
    "ModelVersion": {
      "Type": "String"
    },
    "ModelSha256": {
      "Type": "String",
      "AllowedPattern": "[a-f0-9]{64}"
    },
    "ModelIdentity": {
      "Type": "String"
    },
    "ModelExporterVersion": {
      "Type": "String"
    }
  },
  "Resources": {
    "MediaBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "ecoguard-g80-media-${AWS::AccountId}-${AWS::Region}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "CorsConfiguration": {
          "CorsRules": [
            {
              "AllowedOrigins": [
                {
                  "Ref": "FrontendOrigin"
                }
              ],
              "AllowedMethods": [
                "PUT",
                "GET",
                "HEAD"
              ],
              "AllowedHeaders": [
                "content-type",
                "x-amz-checksum-sha256",
                "if-none-match"
              ],
              "ExposedHeaders": [
                "ETag",
                "x-amz-version-id"
              ],
              "MaxAge": 300
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            },
            {
              "Id": "ExpireTemporaryQueries",
              "Status": "Enabled",
              "Prefix": "queries/",
              "ExpirationInDays": 1,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 1
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "AussieEcoGuardG80"
          }
        ],
        "NotificationConfiguration": {
          "LambdaConfigurations": [
            {
              "Event": "s3:ObjectCreated:*",
              "Function": {
                "Fn::GetAtt": [
                  "ProcessorFunction",
                  "Arn"
                ]
              },
              "Filter": {
                "S3Key": {
                  "Rules": [
                    {
                      "Name": "prefix",
                      "Value": "incoming/"
                    }
                  ]
                }
              }
            },
            {
              "Event": "s3:ObjectCreated:*",
              "Function": {
                "Fn::GetAtt": [
                  "ProcessorFunction",
                  "Arn"
                ]
              },
              "Filter": {
                "S3Key": {
                  "Rules": [
                    {
                      "Name": "prefix",
                      "Value": "thumbnails/"
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "DependsOn": [
        "ProcessorInvokePermission"
      ]
    },
    "MediaBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "MediaBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "RequireTLS",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "MediaBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${MediaBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/ecoguard-g80-api",
        "RetentionInDays": 14
      }
    },
    "ApiFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "ApiLogs",
      "Properties": {
        "FunctionName": "ecoguard-g80-api",
        "Runtime": "nodejs22.x",
        "Handler": "dist/cloud/handler.handler",
        "Role": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/LabRole"
        },
        "MemorySize": 512,
        "Timeout": 30,
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ArtifactKey"
          }
        },
        "Environment": {
          "Variables": {
            "ECOGUARD_GCP_PROJECT": "fit3184-g80-ecoguard-dg26",
            "ECOGUARD_MEDIA_BUCKET": {
              "Ref": "MediaBucket"
            },
            "ECOGUARD_USER_POOL_ID": "us-east-1_HUV4NQ98r",
            "ECOGUARD_CLIENT_ID": "43n2ru3iuds0ph59ldme1adv5l",
            "ECOGUARD_FRONTEND_ORIGIN": {
              "Ref": "FrontendOrigin"
            },
            "ECOGUARD_PROCESSOR_FUNCTION": {
              "Ref": "ProcessorFunction"
            },
            "ECOGUARD_INFERENCE_FUNCTION": {
              "Ref": "InferenceFunction"
            }
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "AussieEcoGuardG80"
          }
        ],
        "ReservedConcurrentExecutions": 2
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": "Aussie EcoGuard G80",
        "ProtocolType": "HTTP",
        "CorsConfiguration": {
          "AllowOrigins": [
            {
              "Ref": "FrontendOrigin"
            }
          ],
          "AllowMethods": [
            "GET",
            "POST",
            "DELETE",
            "OPTIONS"
          ],
          "AllowHeaders": [
            "authorization",
            "content-type"
          ],
          "MaxAge": 300
        }
      }
    },
    "JwtAuthorizer": {
      "Type": "AWS::ApiGatewayV2::Authorizer",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "Name": "CognitoAccessTokens",
        "AuthorizerType": "JWT",
        "IdentitySource": [
          "$request.header.Authorization"
        ],
        "JwtConfiguration": {
          "Audience": [
            "43n2ru3iuds0ph59ldme1adv5l"
          ],
          "Issuer": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_HUV4NQ98r"
        }
      }
    },
    "ApiIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "ApiFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 29000
      }
    },
    "ProtectedRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "ANY /api/{proxy+}",
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "JwtAuthorizer"
        },
        "AuthorizationScopes": [
          "aws.cognito.signin.user.admin"
        ],
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "ApiIntegration"
              }
            ]
          ]
        }
      }
    },
    "LogoutRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "DELETE /api/auth/session",
        "AuthorizationType": "NONE",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "ApiIntegration"
              }
            ]
          ]
        }
      }
    },
    "DefaultStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 5,
          "ThrottlingRateLimit": 2
        }
      }
    },
    "ApiPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "ApiFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:aws:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*"
        }
      }
    },
    "PreflightRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "OPTIONS /api/{proxy+}",
        "AuthorizationType": "NONE",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "ApiIntegration"
              }
            ]
          ]
        }
      }
    },
    "ThumbnailLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/ecoguard-g80-thumbnail",
        "RetentionInDays": 14
      }
    },
    "ProcessorLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/ecoguard-g80-processor",
        "RetentionInDays": 14
      }
    },
    "ThumbnailFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "ThumbnailLogs",
      "Properties": {
        "FunctionName": "ecoguard-g80-thumbnail",
        "Runtime": "python3.12",
        "Handler": "cloud_thumbnail.handler",
        "Role": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/LabRole"
        },
        "MemorySize": 1024,
        "Timeout": 60,
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ThumbnailArtifactKey"
          }
        },
        "Environment": {
          "Variables": {
            "ECOGUARD_MEDIA_BUCKET": {
              "Fn::Sub": "ecoguard-g80-media-${AWS::AccountId}-${AWS::Region}"
            }
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "AussieEcoGuardG80"
          }
        ],
        "ReservedConcurrentExecutions": 2
      }
    },
    "ProcessorFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "ProcessorLogs",
      "Properties": {
        "FunctionName": "ecoguard-g80-processor",
        "Runtime": "nodejs22.x",
        "Handler": "dist/cloud/processor-handler.handler",
        "Role": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/LabRole"
        },
        "MemorySize": 512,
        "Timeout": 900,
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ArtifactKey"
          }
        },
        "Environment": {
          "Variables": {
            "ECOGUARD_GCP_PROJECT": "fit3184-g80-ecoguard-dg26",
            "ECOGUARD_MEDIA_BUCKET": {
              "Fn::Sub": "ecoguard-g80-media-${AWS::AccountId}-${AWS::Region}"
            },
            "ECOGUARD_IMAGE_VALIDATOR_FUNCTION": {
              "Ref": "ThumbnailFunction"
            },
            "ECOGUARD_INFERENCE_FUNCTION": {
              "Ref": "InferenceFunction"
            },
            "ECOGUARD_MODEL_SHA256": {
              "Ref": "ModelSha256"
            }
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "AussieEcoGuardG80"
          }
        ],
        "ReservedConcurrentExecutions": 2
      }
    },
    "ProcessorInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "ProcessorFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "s3.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:aws:s3:::ecoguard-g80-media-${AWS::AccountId}-${AWS::Region}"
        }
      }
    },
    "WorkerFailureQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "ecoguard-g80-processing-failures",
        "SqsManagedSseEnabled": true,
        "MessageRetentionPeriod": 1209600,
        "Tags": [
          {
            "Key": "Project",
            "Value": "AussieEcoGuardG80"
          }
        ]
      }
    },
    "ProcessorAsyncConfig": {
      "Type": "AWS::Lambda::EventInvokeConfig",
      "Properties": {
        "FunctionName": {
          "Ref": "ProcessorFunction"
        },
        "Qualifier": "$LATEST",
        "MaximumRetryAttempts": 2,
        "MaximumEventAgeInSeconds": 3600,
        "DestinationConfig": {
          "OnFailure": {
            "Destination": {
              "Fn::GetAtt": [
                "WorkerFailureQueue",
                "Arn"
              ]
            }
          }
        }
      }
    },
    "InferenceLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/ecoguard-g80-inference",
        "RetentionInDays": 14
      }
    },
    "InferenceFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "InferenceLogs",
      "Properties": {
        "FunctionName": "ecoguard-g80-inference",
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "cloud_inference.handler",
        "Role": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/LabRole"
        },
        "MemorySize": 2048,
        "Timeout": 780,
        "ReservedConcurrentExecutions": 2,
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "InferenceArtifactKey"
          }
        },
        "Environment": {
          "Variables": {
            "ECOGUARD_MEDIA_BUCKET": {
              "Fn::Sub": "ecoguard-g80-media-${AWS::AccountId}-${AWS::Region}"
            },
            "ECOGUARD_MODEL_BUCKET": {
              "Fn::Sub": "ecoguard-g80-media-${AWS::AccountId}-${AWS::Region}"
            },
            "ECOGUARD_MODEL_KEY": {
              "Ref": "ModelKey"
            },
            "ECOGUARD_MODEL_VERSION": {
              "Ref": "ModelVersion"
            },
            "ECOGUARD_MODEL_SHA256": {
              "Ref": "ModelSha256"
            },
            "ECOGUARD_MODEL_IDENTITY": {
              "Ref": "ModelIdentity"
            },
            "ECOGUARD_MODEL_EXPORTER_VERSION": {
              "Ref": "ModelExporterVersion"
            },
            "ECOGUARD_CONFIDENCE": "0.25"
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "AussieEcoGuardG80"
          }
        ]
      }
    },
    "RecoverySchedule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Name": "ecoguard-g80-recovery",
        "ScheduleExpression": "rate(5 minutes)",
        "State": "ENABLED",
        "Targets": [
          {
            "Id": "RecoverMedia",
            "Arn": {
              "Fn::GetAtt": [
                "ProcessorFunction",
                "Arn"
              ]
            },
            "Input": "{\"reconcile\":true}"
          }
        ]
      }
    },
    "RecoveryPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "ProcessorFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "RecoverySchedule",
            "Arn"
          ]
        }
      }
    },
    "NotificationLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/ecoguard-g80-notifications",
        "RetentionInDays": 14
      }
    },
    "NotificationFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "NotificationLogs",
      "Properties": {
        "FunctionName": "ecoguard-g80-notifications",
        "Runtime": "nodejs22.x",
        "Handler": "dist/cloud/notification-handler.handler",
        "Role": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/LabRole"
        },
        "MemorySize": 512,
        "Timeout": 60,
        "ReservedConcurrentExecutions": 1,
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ArtifactKey"
          }
        },
        "Environment": {
          "Variables": {
            "ECOGUARD_GCP_PROJECT": "fit3184-g80-ecoguard-dg26",
            "ECOGUARD_FRONTEND_ORIGIN": {
              "Ref": "FrontendOrigin"
            }
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "AussieEcoGuardG80"
          }
        ]
      }
    },
    "NotificationSchedule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Name": "ecoguard-g80-notifications",
        "ScheduleExpression": "rate(1 minute)",
        "State": "ENABLED",
        "Targets": [
          {
            "Id": "PublishAlerts",
            "Arn": {
              "Fn::GetAtt": [
                "NotificationFunction",
                "Arn"
              ]
            },
            "Input": "{}"
          }
        ]
      }
    },
    "NotificationPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "NotificationFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "NotificationSchedule",
            "Arn"
          ]
        }
      }
    },
    "NotificationAsyncConfig": {
      "Type": "AWS::Lambda::EventInvokeConfig",
      "Properties": {
        "FunctionName": {
          "Ref": "NotificationFunction"
        },
        "Qualifier": "$LATEST",
        "MaximumRetryAttempts": 2,
        "MaximumEventAgeInSeconds": 3600,
        "DestinationConfig": {
          "OnFailure": {
            "Destination": {
              "Fn::GetAtt": [
                "WorkerFailureQueue",
                "Arn"
              ]
            }
          }
        }
      }
    }
  },
  "Outputs": {
    "ApiEndpoint": {
      "Value": {
        "Fn::GetAtt": [
          "HttpApi",
          "ApiEndpoint"
        ]
      }
    },
    "MediaBucket": {
      "Value": {
        "Ref": "MediaBucket"
      }
    },
    "ApiFunction": {
      "Value": {
        "Ref": "ApiFunction"
      }
    },
    "ProcessorFunction": {
      "Value": {
        "Ref": "ProcessorFunction"
      }
    },
    "FailureQueue": {
      "Value": {
        "Ref": "WorkerFailureQueue"
      }
    }
  }
}
