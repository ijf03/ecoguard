{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "test:real": "node scripts/test-real.mjs",
    "test:cloud": "tsx --test tests/cloud/*.test.ts",
    "test:cloud:live": "node scripts/test-firestore-live.mjs",
    "package:lambda": "npm run build && node scripts/package-lambda.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-lambda": "3.1164.0",
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/client-ssm": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@google-cloud/firestore": "9.4.0",
    "google-auth-library": "10.5.0",
    "jose": "6.2.15"
  },
  "overrides": {
    "rimraf": "6.1.4"
  }
}
