# Public Cognito configuration. Never put AWS keys or a client secret in VITE_ variables.
VITE_COGNITO_USER_POOL_ID=us-east-1_HUV4NQ98r
VITE_COGNITO_CLIENT_ID=43n2ru3iuds0ph59ldme1adv5l
# Explicit unauthenticated development only; ignored in production builds.
VITE_LOCAL_DEV=false

# Opt into signed cloud uploads only after deployed processing is verified.
VITE_CLOUD_UPLOADS=false
# Development proxy (same-origin API requests).
# VITE_API_PROXY=https://YOUR_API.execute-api.us-east-1.amazonaws.com
# For HTTPS static hosting, use the explicit protected API origin; API/S3 CORS must match the frontend.
# VITE_API_ORIGIN=https://YOUR_API.execute-api.us-east-1.amazonaws.com
